meta {
  name: Aceita uma consulta de elegibilidade
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/elegibilidades
  body: json
  auth: none
}

body:json {
  {
    "cpf": "12345678901",
    "codigo_operadora": "OPS-001",
    "matricula_plano": "MAT-2026-001"
  }
}

docs {
  Valida o pedido, cria um protocolo efêmero e informa onde consultar o recurso aceito.
}
